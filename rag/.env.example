# --- Server ---
RAG_PORT=8001

# --- Vector store ---
# Defaults to ./data/chroma (relative to wherever the service is run from)
# for safe local/manual runs. docker-compose.yml overrides this to /data/chroma
# inside the container, backed by a named volume.
CHROMA_PERSIST_DIR=./data/chroma

# --- Embedding backend (Hugging Face by default) ---
# Leave EMBEDDING_BACKEND unset/"huggingface" to use Hugging Face models.
EMBEDDING_BACKEND=huggingface
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# If set, embeddings are computed via the Hugging Face hosted Inference API
# (no local model download, lighter Docker image). Get a free token at
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# If HUGGINGFACE_API_KEY is empty, the service loads HUGGINGFACE_MODEL
# locally via `sentence-transformers` instead (first run downloads the model,
# ~90MB for the default all-MiniLM-L6-v2).

# --- Optional alternative embedding backend ---
# Set EMBEDDING_BACKEND=openai and provide a key to use OpenAI embeddings
# instead of Hugging Face. Not used unless explicitly selected.
OPENAI_API_KEY=
