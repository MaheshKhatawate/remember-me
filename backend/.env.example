# --- Server ---
PORT=3000
# Public/base URL where THIS backend is reachable, used by the bot service to call itself.
BACKEND_URL=http://127.0.0.1:3000
# Optional shared secret. When set, all /api/* routes require header: x-api-key: <value>
BACKEND_API_SECRET=

# --- MongoDB (audit trail + local RAG fallback index) ---
MONGODB_URI=mongodb://localhost:27017/readme-assistant

# --- Auth (reserved for future use) ---
JWT_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Optional comma-separated allowlist of Telegram numeric user IDs. When set,
# only these users may interact with the bot. Find your ID by messaging
# @userinfobot on Telegram. Leave empty to allow anyone.
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM (Groq via LangChain) used for intent classification + answer synthesis ---
GROQ_API_KEY=

# --- GitHub ---
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main

# --- Python RAG microservice ---
# When set, the backend delegates chunking/embedding/semantic search to the
# standalone Python RAG service instead of the local MongoDB hash-embedding
# fallback. In docker-compose this is set to http://rag:8001 automatically.
RAG_SERVICE_URL=http://localhost:8001
RAG_SERVICE_TIMEOUT_MS=8000
